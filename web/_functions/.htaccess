# ==============================================================================
# 🔐 CueRCode - Deny all direct web access to shared functions
# These files are loaded via PHP require/include and must not be directly accessible
# @see https://httpd.apache.org/docs/2.4/howto/htaccess.html
# ==============================================================================

# 🚫 Apache 2.4+ syntax
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# 🚫 Apache 2.2 fallback syntax
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
