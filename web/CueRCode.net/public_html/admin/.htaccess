# ==============================================================================
# 🛡️ CueRCode - Admin area (/admin/) security headers
# ==============================================================================
# Path: public_html/admin/.htaccess
#
# Extra protection for the private Global Admin area (task 7n Phase 1B,
# plan §7.4). Everything else (rewriting, error pages, the other security
# headers) still comes from public_html/.htaccess.
#
#   - X-Frame-Options DENY + CSP frame-ancestors 'none': no other page, not
#     even one on this site, may show an admin page inside a frame
#     (clickjacking).
#   - Cache-Control no-store: browsers and proxies never keep a copy of an
#     admin page.
#   - X-Robots-Tag noindex, nofollow: search engines never list an admin page.
#   - The Content-Security-Policy is the SITE policy from public_html/.htaccess
#     with frame-ancestors 'none'. Scripts still come only from this site and
#     https://cdn.jsdelivr.net - no new script source. Keep the two in step.
#
# Each header must be sent ONCE. "Header always set" alone does NOT do that:
# public_html/.htaccess uses plain "Header set" (which Apache keeps in a
# separate list that only applies to successful answers), so on a normal 200
# page a browser would get the site value AND the admin value (checked on a
# real Apache 2.4.71: X-Frame-Options, Content-Security-Policy and
# Cache-Control were each sent twice). So each header is first removed with
# "Header unset" (clears the site value) and "Header always unset", and then
# set with "Header always set". mod_expires would add its own
# "Cache-Control: max-age=0" to static files, so it is switched off here. The
# admin PHP code (adminSendSecurityHeaders() in _functions/fn_admin.php)
# sends the same headers itself too, in case a host ignores these lines.
#
# Which answers get these headers (measured on Apache 2.4.71 in Docker,
# 2026-11-25, review finding 10 - an earlier version of this comment said
# "also on error pages", which was only half true):
#   - YES: every admin page, including one that itself answers with an error
#     status (for example a PHP admin page refusing with 403).
#   - NO: Apache's OWN error page for a file under /admin/ that does not exist
#     (404) or may not be read (403). Apache hands those to /error/404.php and
#     /error/403.php (ErrorDocument in public_html/.htaccess), which are
#     outside this folder and carry the site's ordinary headers. Those pages
#     show no admin content, so this is accepted rather than worked around.
#
# The admin path is deliberately NOT listed in robots.txt: that would
# advertise it.
#
# @package     CueRCode
# @copyright   2025–2026 MWBM Partners Ltd
# @since       2026-11-24 (task 7n Phase 1B, #31)
# @see         https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Content-Security-Policy/frame-ancestors
# @see         https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Cache-Control
# ==============================================================================

<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Frame-Options
    Header always unset X-Frame-Options
    Header unset Cache-Control
    Header always unset Cache-Control
    Header unset X-Robots-Tag
    Header always unset X-Robots-Tag
    Header unset Content-Security-Policy
    Header always unset Content-Security-Policy
    Header always set X-Frame-Options "DENY"
    Header always set Cache-Control "no-store"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# 📁 No folder listings
Options -Indexes
